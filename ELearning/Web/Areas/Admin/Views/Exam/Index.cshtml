

@{
    ViewBag.Title = "Danh sách bài thi";
}
<div class="row">
    <div class="col-lg-12">
        <div id="customerList">
            <div class="card">
                <div class="card-body">
                    <div class="row g-4 mb-3">
                        <div class="col-sm-auto">
                            <div>
                                <a class="btn btn-primary" asp-action="CreateExam" asp-controller="Exam" asp-area="Admin" >
                                    <i class="ri-add-line align-bottom me-1"></i> TẠO BÀI THI
                                </a>
                            </div>
                        </div>

                        <div class="col-sm">
                            <div class="d-flex justify-content-sm-end">
                                <div class="search-box ms-2">
                                    <input type="text" class="form-control search"
                                            placeholder="Search...">
                                    <i class="ri-search-line search-icon"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="row">
                    <div class="col-md-12">
                        <button class="btn btn-sm btn-soft-secondary rounded-pill px-3 ms-3 mt-3">Đang mở</button>
                        <div class="block block-rounded block-fx-pop mb-2">
                            <div class="block-content block-content-full border-start border-3 border-${state.color}">
                                <div class="d-md-flex justify-content-md-between align-items-md-center">
                                    <div class="p-1 p-md-3">
                                        <h3 class="h4 fw-bold mb-3">
                                            <a href="./test/detail/${test.made}" class="text-dark link-fx">Tên đề</a>
                                        </h3>
                                        <p class="text-muted mb-2 text-dark">
                                            <i class="las la-layer-group me-1"></i>
                                            Giao cho học phần
                                            <strong title="${test.nhom}" style="cursor:pointer">
                                                nhóm học phần
                                            </strong>
                                        </p>
                                        <p class="text-muted mb-0">
                                            <i class="la la-clock me-1"></i> Diễn ra từ <span>23423432</span> đến
                                            <span>4r2343</span>
                                        </p>
                                    </div>
                                    <div class="p-1 p-md-3">
                                        <a class="btn btn-soft-success rounded-pill px-3 me-1 my-1"
                                           href="./test/detail/${test.made}">
                                            <i class="las la-eye opacity-50 me-1"></i> Xem chi tiết
                                        </a>
                                        <a data-role="dethi" data-action="update"
                                           class="btn btn-soft-primary rounded-pill px-3 me-1 my-1"
                                           href="./test/update/${test.made}">
                                            <i class="la la-wrench opacity-50 me-1"></i> Chỉnh sửa
                                        </a>
                                        <a data-role="dethi" data-action="delete"
                                           class="btn btn-soft-danger rounded-pill px-3 my-1 btn-delete"
                                           href="javascript:void(0)" data-id="${test.made}">
                                            <i class="la la-times opacity-50 me-1"></i> Xoá đề
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

           @*  <partial name="_pagedList" model="@Model" /> *@

        </div>
    </div>
</div>




