@model IEnumerable<Web.Areas.Admin.ViewModels.QuestionVM.ListQuestionVM>

@{
    ViewBag.Title = "Danh sách câu hỏi";

}

@section scripts {
    <script src="~/assets/libs/list.pagination.js/list.pagination.min.js"></script>
    @* <script src="~/assets/js/pages/form-pickers.init.js"></script>   *@
    <script src="~/js/dashmix.app.min.js"></script>
    <script src="~/js/pages/user.js" asp-append-version="true"></script>
    <script src="~/AdminJs/question.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap-notify/bootstrap-notify.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/toastr@2.1.4/toastr.min.js"></script>

}

<div x-data="question">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-0">Danh sách câu hỏi</h4>
                </div><!-- end card header -->

                <div class="card-body">
                    <div id="customerList">
                        <div class="row g-4 mb-3">
                            <div class="col-sm-auto">
                                <div>
                                    <button type="button" class="btn btn-primary add-btn"
                                            x-on:click="OpenModelAdd()">
                                        <i class="ri-add-line align-bottom me-1"></i> Thêm câu hỏi
                                    </button>
                                    <button class="btn btn-soft-danger"
                                            onClick="deleteMultiple()">
                                        <i class="ri-delete-bin-2-line"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="col-sm">
                                <div class="d-flex justify-content-sm-end">
                                    <div class="search-box ms-2">
                                        <input type="text" class="form-control search"
                                               placeholder="Search...">
                                        <i class="ri-search-line search-icon"></i>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive table-card mt-3 mb-1">

                            <table class="table align-middle table-nowrap" id="customerTable">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col" style="width: 50px;">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox"
                                                       id="checkAll" value="option">
                                            </div>
                                        </th>

                                        <th>Id</th>
                                        <th>Nội dung câu hỏi</th>
                                        <th>Tên môn học</th>
                                        <th>Tên chương</th>
                                        <th>Độ khó</th>
                                        <th>Hoạt động</th>
                                    </tr>
                                </thead>
                                <tbody class="list form-check-all">
                                    <template x-for="item in _list">
                                        <tr>
                                            <th scope="row">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox"
                                                           name="chk_child" value="option1">
                                                </div>
                                            </th>
                                            <td class="id" style="display:none;">
                                                <a class="fw-medium link-primary" x-text="item.id"></a>
                                            </td>
                                            <td class="id_student" x-text="item.mssv"></td>
                                            <td class="email">
                                                <div class="d-flex flex-column">
                                                    <strong class="text-primary" x-text="item.fullName">

                                                    </strong>
                                                    <p x-text="item.email"></p>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex gap-2">
                                                    <div class="edit">
                                                        <a class="btn btn-sm edit-item-btn link-primary fs-15"
                                                           x-on:click="openModalUpdate(item.id)">
                                                            <i class="ri-edit-2-line"></i>
                                                        </a>
                                                    </div>
                                                    <div class="remove">
                                                        <a class="btn btn-sm remove-item-btn link-danger fs-15"
                                                           data-bs-toggle="modal" data-bs-target="#deleteRecordModal">
                                                            <i class="ri-delete-bin-line"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </template>
                                </tbody>
                            </table>

                            <div class="noresult" style="display:none">
                                <div class="text-center">
                                    <lord-icon src="https://cdn.lordicon.com/msoeawqm.json"
                                               trigger="loop" colors="primary:#121331,secondary:#08a88a"
                                               style="width:75px;height:75px"></lord-icon>
                                    <h5 class="mt-2">Xin lỗi! không tìm thấy</h5>
                                    <p class="text-muted mb-0">
                                        hãy nhập lại tên mà bạn muốn tìm kiếm
                                    </p>
                                </div>
                            </div>

                        </div>

                        <partial name="_pagedList" />
                    </div>
                </div><!-- end card -->
            </div>
            <!-- end col -->
        </div>
        <!-- end col -->
    </div>
    <!-- end row -->

    <partial name="_modalUpSert" model="null" />


</div>
