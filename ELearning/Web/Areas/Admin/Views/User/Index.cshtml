@model IEnumerable<Web.Areas.Admin.ViewModels.user.ListUserVM>;

@{
    ViewBag.Title = "Danh sách người dùng";
}

@section scripts{
    <script src="~/assets/libs/prismjs/prism.js"></script>
    <script src="~/assets/libs/list.js/list.min.js"></script>
    <script src="~/assets/libs/list.pagination.js/list.pagination.min.js"></script>
    <script src="~/assets/js/pages/listjs.init.js" asp-append-version="true"></script>
    @* <script src="~/assets/js/pages/form-pickers.init.js"></script> *@

}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">Danh sách người dùng</h4>
            </div><!-- end card header -->

            <div class="card-body">
                <div id="customerList">
                    <div class="row g-4 mb-3">
                        <div class="col-sm-auto">
                            <div>
                                <button type="button" class="btn btn-primary add-btn"
                                        data-bs-toggle="modal" data-bs-target=".bs-example-modal-lg">
                                    <i class="ri-add-line align-bottom me-1"></i> Thêm người dùng
                                </button>
                                <button class="btn btn-soft-danger"
                                        onClick="deleteMultiple()">
                                    <i class="ri-delete-bin-2-line"></i>
                                </button>
                            </div>
                        </div>

                        <div class="col-sm">
                            <div class="d-flex justify-content-sm-end">
                                <div class="search-box ms-2">
                                    <input type="text" class="form-control search"
                                           placeholder="Search...">
                                    <i class="ri-search-line search-icon"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive table-card mt-3 mb-1">

                        <table class="table align-middle table-nowrap" id="customerTable">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" style="width: 50px;">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                    id="checkAll" value="option">
                                        </div>
                                    </th>

                                    <th class="sort" data-sort="id_student">MSSV</th>
                                    <th class="sort" data-sort="email">Họ tên</th>
                                    <th class="sort" data-sort="gender">Giới tính</th>
                                    <th class="sort" data-sort="date">Ngày sinh</th>
                                    <th class="sort" data-sort="roleName">Nhóm quyền</th>
                                    <th class="sort" data-sort="status">Trạng thái</th>
                                    <th class="sort" data-sort="action">Hoạt động</th>
                                </tr>
                            </thead>
                            <tbody class="list form-check-all">
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <th scope="row">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox"
                                                        name="chk_child" value="option1">
                                            </div>
                                        </th>
                                        <td class="id" style="display:none;">
                                            <a class="fw-medium link-primary">#VZ2101</a>
                                        </td>
                                        <td class="id_student">@item.MSSV</td>
                                        <td class="email">
                                            <div  class="d-flex flex-column">
                                                <strong class="text-primary">@item.FullName</strong>
                                                <p>@item.Email</p>
                                            </div>
                                        </td>
                                        <td class="gender">@item.Gender</td>
                                        <td class="date">@item.Birthday.ToDMY()</td>
                                        <td class="roleName">@item.RoleName</td>
                                        @if (!item.IsBlock)
                                        {
                                            <td class="status">
                                                <span class="badge badge-soft-primary text-uppercase">Active</span>
                                            </td>

                                        }
                                        else
                                        {
                                            <td class="status">
                                                <span class="badge badge-soft-danger text-uppercase">Block</span>
                                            </td>
                                        }
                                       
                                        <td>
                                            <div class="d-flex gap-2">
                                                <div class="edit">
                                                    <button class="btn btn-sm edit-item-btn link-primary fs-15" data-bs-toggle="modal" data-bs-target="#showModal"><i class="ri-edit-2-line"></i></button>
                                                </div>
                                                <div class="remove">
                                                    <button class="btn btn-sm remove-item-btn link-danger fs-15" data-bs-toggle="modal" data-bs-target="#deleteRecordModal"><i class="ri-delete-bin-line"></i></button>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        
                        <div class="noresult" style="display:none">
                            <div class="text-center">
                                <lord-icon src="https://cdn.lordicon.com/msoeawqm.json"
                                            trigger="loop" colors="primary:#121331,secondary:#08a88a"
                                            style="width:75px;height:75px"></lord-icon>
                                <h5 class="mt-2">Xin lỗi! không tìm thấy</h5>
                                <p class="text-muted mb-0">
                                    hãy nhập lại tên mà bạn muốn tìm kiếm
                                </p>
                            </div>
                        </div>
                                                
                    </div>

                    <partial name="_pagedList" />
                        
@*                     <div class="d-flex justify-content-end">
                        <div class="pagination-wrap hstack gap-2">
                            <a class="page-item pagination-prev disabled" href="#">
                                Previous
                            </a>
                            <ul class="pagination listjs-pagination mb-0"></ul>
                            <a class="page-item pagination-next" href="#">
                                Next
                            </a>
                        </div>
                    </div> *@

                </div>
            </div><!-- end card -->
        </div>
        <!-- end col -->
    </div>
    <!-- end col -->
</div>
<!-- end row -->

<partial name="_modalUpdin" model="null"/>

<partial name="_modalDelete" />

