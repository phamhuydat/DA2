<div class="modal fade bs-example-modal-lg" id="showModal" tabindex="-1" aria-labelledby="exampleModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-light p-3">
                <ul class="nav nav-tabs nav-tabs-block" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active" id="btabs-static-home-tab"
                                data-bs-target="#btabs-static-home"
                                aria-selected="true">
                            Thêm thủ công
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" id="btabs-static-profile-tab"
                                data-bs-target="#btabs-static-profile"
                                aria-selected="false">
                            Thêm từ file
                        </button>
                    </li>
                </ul>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        aria-label="Close" id="close-modal"></button>
            </div>

            <!--thêm một người dùng-->
            <div class="modal-body block-content tab-content">
                <form class="tab-pane active form-add-user">
                    <div>
                        <div class="mb-4">
                            <div class="row">
                                <div class="col-md-6">
                                    <label class="form-label">Mã sinh viên</label>
                                    <input type="text" class="form-control form-control-alt" 
                                           x-model="_updinData.mssv" id="masinhvien"
                                           placeholder="Nhập mã sinh viên">
                                    <span class="text-danger" id="mssv"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Họ và tên</label>
                                    <input type="text" class="form-control form-control-alt" x-model="_updinData.fullName" id="user_name"
                                           placeholder="Nhập họ và tên">
                                    <span class="text-danger" id="fullName"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="row">
                                <div class="col-md-6">
                                    <label class="form-label">Email</label>
                                    <input type="email" class="form-control form-control-alt" x-model="_updinData.email" id="user_email"
                                           placeholder="Nhập địa chỉ email">
                                    <span class="text-danger" id="email"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Số điện thoại</label>
                                    <input type="text" class="form-control form-control-alt" x-model="_updinData.phone" id="user_email"
                                           placeholder="Nhập số điện thoại">
                                    <span class="text-danger" id="phoneNumber"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="row">
                                <div class="col-md-6" >
                                    <label class="form-label">Nhóm quyền</label>
                                    <select id="roleSelect" x-model="_updinData.appRoleId" class="form-control bs-autocomplete">
                                        <vc:list-role :seleteted-id="_updinData.appRoleId"></vc:list-role>
                                    </select>

                                    @* <span asp-validation-for="AppRoleId" class="text-danger"></span> *@
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label"> Ngày sinh</label>
                                     <input type="text" class="form-control flatpickr-input" id="datepicker" data-provider="flatpickr"
                                           data-altFormat="F j, Y" x-model="_updinData.birthday" placeholder="Ngày sinh">
                                    <span class="text-danger" id="birthday"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="mb-4 d-flex gap-4">
                            <label class="form-label">Giới tính</label>
                            <div class="space-x-2">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" id="gender-male" x-model="_updinData.gender"
                                           value="Nam">
                                    <label class="form-check-label" for="gender-male">Nam</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" id="gender-female" x-model="_updinData.gender"
                                           value="Nu">
                                    <label class="form-check-label" for="gender-female">Nữ</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Mật khẩu</label>
                            <input type="password" class="form-control form-control-alt" x-model="_updinData.password"
                                   id="user_password" placeholder="Nhập mật khẩu">
                            <span class="text-danger" id="password"></span>
                        </div>

@*                         <div class="mb-4">
                            <label asp-for="ConfirmPwd" class="form-label">Nhập lại mật khẩu</label>
                            <input type="password" class="form-control form-control-alt" asp-for="ConfirmPwd"
                                   id="user_password" placeholder="Nhập mật khẩu">
                        </div> *@

                    </div>

                    <div class="modal-footer">
                        <div class="hstack gap-2 justify-content-end">
                            <button type="button" class="btn btn-light"
                                    data-bs-dismiss="modal">
                                Dóng
                            </button>
                            <button type="submit" class="btn btn-primary" 
                                x-text="_modalSetting.primaryButtonText" @@click="saveCategory()"></button>
                        </div>
                    </div>
                </form>

                <!--thêm nhiều người dùng-->
                <div class="tab-pane" id="btabs-static-profile" role="tabpanel"
                     aria-labelledby="btabs-static-profile-tab" tabindex="0">
                    <form id="form-upload" method="POST" enctype="multipart/form-data">
                        <div class="mb-4">
                            <label for="user_password" class="form-label">Mật khẩu</label>
                            <input type="password" class="form-control form-control-alt" name="user_password"
                                   id="ps_user_group" placeholder="Nhập mật khẩu cho sinh viên!">
                        </div>
                        <div class="mb-4">
                            <label class="form-label" for="js-ckeditor">Nội dung</label>
                            <input class="form-control" type="file" id="file-cau-hoi" accept=".xlsx, .xls, .csv"
                                   required>
                        </div>
                        <div class="mb-4">
                            <em>
                                Vui lòng soạn người dùng theo đúng định dạng.
                                <a class="text-primary" href="~/template/file_import_ds_nguoi_dung.xlsx">
                                    Tải về file mẫu
                                    Excel
                                </a>
                            </em>
                        </div>

                        <div class="mb-4 d-flex justify-content-between">
                            <button type="submit" class="btn btn-hero btn-primary" id="nhap-file">
                                <i class="fa fa-cloud-arrow-up"></i> Thêm vào hệ thống
                            </button>
                        </div>
                    </form>
                </div>
           </div>
        </div>
    </div>
</div>
