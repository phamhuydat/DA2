@{

    ViewBag.Title = "Danh sách bài thi";
}
@section head {
    <link rel="stylesheet" id="css-main" href="~/css/dashmix.css">
    <link rel="stylesheet" id="css-main" href="~/css/custom.css">
}
@section Scripts {
    <script src="~\js\pages\test_schedule.js"></script>
}
<div class="main-content">
    <div class="page-content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                        <h4 class="mb-sm-0">Danh sách bài thi</h4>

                        <div class="page-title-right">
                            <ol class="breadcrumb m-0">
                                <li class="breadcrumb-item"><a href="javascript: void(0);">Pages</a></li>
                                <li class="breadcrumb-item active">Team</li>
                            </ol>
                        </div>

                    </div>
                </div>
            </div>

            <div class="pe-2 me-n1 mb-3" data-simplebar style="height: 400px">
                <div id="upcoming-event-list">
                    <div class="card mb-3 p-3">
                        <div class="card-body">

                            <div class="d-flex mb-3">
                                <div class="flex-grow-1">
                                    <i class="mdi mdi-checkbox-blank-circle me-2 text-info">
                                    </i><span class="fw-medium">Thangs 4 năm 2022 </span>
                                </div>
                                <div class="flex-shrink-0"><small class="badge badge-soft-primary ms-auto">7:00 AM to 12:00 AM</small></div>
                            </div>
                            <div class="d-flex mb-3">
                                <div class="flex-grow-1">
                                    <h6 class="card-title fs-16"> World Braille Day</h6>
                                    <p class="text-muted text-truncate-two-lines mb-0">A meeting is a gathering of two or more people that has been convened for the purpose of</p>
                                </div>
                                <div class="d-flex flex-shrink-0">
                                    <button type="button" class="btn rounded-pill btn-soft-success waves-effect waves-light">Đã hoàn thành</button>
                                    <button type="button" class="btn rounded-pill btn-soft-primary waves-effect waves-light">Chi tiết bài thi</button>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
